# Render (and any host) sets NODE_ENV=production, which makes npm default to
# omit=dev and prune devDependencies. The TypeScript build needs them: tsc
# itself survives only because prisma pulls it in as a production dependency,
# so the build would run with its @types/* declarations missing and fail with
# TS7016 / TS7006 on multer, express, morgan, pdfkit and uuid.
#
# `include` wins over `omit`, so this restores devDependencies at install time
# without anyone having to remember a --include=dev flag in the host's build
# command. Removing this line breaks the deploy build, not local dev.
include=dev
