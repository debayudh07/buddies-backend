# ============================================================
# Buddies API env template — copy to .env and fill values
# ============================================================

NODE_ENV=development
PORT=8000

# --- Required: Supabase Postgres ---
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
# Cloud: rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# --- Required for production auth ---
# Flutter apps use SUPABASE_URL + SUPABASE_ANON_KEY (public) with user JWT.
# Express never uses the anon key on the request hot path.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase Dashboard → Project Settings → API → JWT Secret.
# Used for *local* access-token verification (required in production).
SUPABASE_JWT_SECRET=

# Staging only. MUST be false (or unset) in production — boot fails otherwise.
DEV_AUTH_BYPASS=true

# Comma-separated browser/app origins for CORS + dual Socket.IO cutover.
# Required in production (empty = deny all browser origins).
# Example: https://app.buddies.in,https://supplier.buddies.in
ALLOWED_ORIGINS=

# Apply security SQL under supabase/migrations after prisma db push
# (RLS deny-all for anon/authenticated on public tables).

AUCTION_BASE_WINDOW_SEC=86400
AUCTION_AUTO_EXTEND_TRIGGER_SEC=60
AUCTION_AUTO_EXTEND_BY_SEC=120
AUCTION_MAX_EXTENDS=5
AUCTION_MIN_DECREMENT_PAISE=1000
SLA_HOURS=8
INSPECTION_WINDOW_SEC=600
TRACKING_STALE_SEC=120

# Production: set true + credentials
FCM_ENABLED=false
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
