# ============================================================
# Buddies API env template — copy to .env and fill values
# ============================================================

NODE_ENV=development
PORT=8000

# --- Required: Supabase Postgres ---
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Redis ---
# Host machine / npm run dev:
REDIS_URL=redis://127.0.0.1:6379
# Inside docker compose, api service overrides to: redis://redis:6379
# Cloud later: rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# --- Required for production auth ---
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

DEV_AUTH_BYPASS=true

AUCTION_BASE_WINDOW_SEC=600
AUCTION_AUTO_EXTEND_TRIGGER_SEC=60
AUCTION_AUTO_EXTEND_BY_SEC=120
AUCTION_MAX_EXTENDS=5
AUCTION_MIN_DECREMENT_PAISE=10000
SLA_HOURS=8
INSPECTION_WINDOW_SEC=600
TRACKING_STALE_SEC=120

FCM_ENABLED=false
# Prefer one-line JSON for Docker / Render (single quotes around the whole value):
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
# Local file fallback:
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
